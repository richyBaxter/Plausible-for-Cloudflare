{
  "name": "@houtini/insights",
  "version": "1.0.0",
  "description": "Privacy-friendly, cookieless web analytics on Cloudflare Workers + D1 — native API, Plausible-compatible ingestion, and a built-in MCP server.",
  "private": true,
  "license": "MIT",
  "author": "Houtini (https://houtini.ai)",
  "repository": {
    "type": "git",
    "url": "https://github.com/houtini-ai/Insights.git"
  },
  "homepage": "https://github.com/houtini-ai/Insights#readme",
  "bugs": "https://github.com/houtini-ai/Insights/issues",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create insights",
    "db:migrate": "wrangler d1 migrations apply insights --remote",
    "db:migrate:local": "wrangler d1 migrations apply insights --local",
    "kv:create": "wrangler kv namespace create SALT_KV",
    "secrets": "echo 'Set: wrangler secret put DASHBOARD_PASSWORD && wrangler secret put AUTH_SECRET && wrangler secret put MCP_API_KEY'",
    "test": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20250101.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
